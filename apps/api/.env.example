NODE_ENV=production
PORT=3010

# Portail OIDC
AUTH_API_URL=https://api-auth.semply.fr
# Chemins ajustables si nginx préfixe (AuthSEmply monte son contrôleur sur /oidc)
AUTH_AUTHORIZE_PATH=/oidc/authorize
AUTH_TOKEN_PATH=/oidc/token
AUTH_USERINFO_PATH=/oidc/userinfo

# Client confidentiel déclaré dans le catalogue OIDC d'AuthSEmply
OIDC_CLIENT_ID=semply-admin
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://admin.semply.fr/api/auth/callback
OIDC_SCOPES=openid profile email

# LISTE BLANCHE du relais : clé=url, séparées par des virgules.
# Le navigateur ne choisit qu'une clé ; toute URL absente d'ici est injoignable.
PRODUCTS=semplyapp=https://api.semply.fr/api,semplycompta=https://api-compta.semply.fr,semplyprevi=https://api-previ.semply.fr,authsemply=https://api-auth.semply.fr
