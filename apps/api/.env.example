NODE_ENV=production
PORT=3010

# Portail OIDC
AUTH_API_URL=https://api-auth.semply.fr
# Chemins ajustables si nginx préfixe (AuthSEmply monte son contrôleur sur /oidc)
AUTH_AUTHORIZE_PATH=/oidc/authorize
AUTH_TOKEN_PATH=/oidc/token
AUTH_USERINFO_PATH=/oidc/userinfo

# Client confidentiel déclaré dans le catalogue OIDC d'AuthSEmply
OIDC_CLIENT_ID=semply-admin
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://admin.semply.fr/api/auth/callback
OIDC_SCOPES=openid profile email

# LISTE BLANCHE du relais : cle=url[|mode[|chemin d'echange]], separees par des virgules.
# Le navigateur ne choisit qu'une cle ; toute URL absente d'ici est injoignable.
#
#   direct    le produit valide les jetons du portail contre son JWKS
#             (@semply/auth) — on lui presente l'access token du portail.
#   exchange  le produit n'autorise que sur sa propre base et veut n'extraire
#             que l'identite du portail : le relais POST l'id_token sur sa
#             route d'echange et se sert du jeton qu'il emet. Cas de SEmplyApp.
PRODUCTS=semplyapp=https://api.semply.fr/api|exchange|auth/oidc/login,semplycompta=https://api-compta.semply.fr|direct,semplyprevi=https://api-previ.semply.fr|direct,authsemply=https://api-auth.semply.fr|direct
